{
    "name": "navbat-app",
    "version": "1.2.0",
    "description": "NamDPI xizmat ko‘rsatilayotgan chiptalar monitori",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder"
    },
    "author": "NamDPI",
    "license": "MIT",
    "devDependencies": {
        "electron": "^29.4.6",
        "electron-builder": "^24.13.3",
        "electron-packager": "^17.1.2"
    },
    "build": {
        "appId": "uz.namdpi.xizmatapp",
        "productName": "NamDPI Xizmat Monitor",
        "directories": {
            "output": "dist"
        },
        "files": [
            "**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "assets/img/queue.ico"
        },
        "publish": {
            "provider": "generic",
            "url": "https://raw.githubusercontent.com/izzatbekulkanov/NamSPI_REGISTRATOR/main/releases/public-display/"
        }
    },
    "dependencies": {
        "electron-updater": "^6.8.9",
        "msedge-tts": "^2.0.7"
    }
}
